# Environment variables (including local and production secrets)
.env
.env.*

# Firebase Admin / Google Cloud service account credentials
firebase-key.json
firebase-key*.json
*firebase-adminsdk*.json
*service-account*.json
*service_account*.json
*serviceAccount*.json
*ServiceAccount*.json
credentials.json
application_default_credentials.json
