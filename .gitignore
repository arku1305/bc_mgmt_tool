secrets/
credentials/

# Private keys and certificate bundles
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Local deployment configuration and dependencies
.vercel/
.firebase/
.npmrc
node_modules/

# Build output, coverage, and runtime logs
dist/
build/
coverage/
*.log

# OS and editor temporary files
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
